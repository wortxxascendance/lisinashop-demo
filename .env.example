# Скопируйте в .env на сервере и заполните. Файл .env в git не попадает.

# --- Сайт ---
PORT=3000
HOST=127.0.0.1
# Публичный адрес сайта (нужен для ссылки возврата после оплаты и для sitemap)
SITE_URL=https://lisinashop.ru
# Включайте 1 только если сервер стоит за nginx (тогда IP покупателя берётся из X-Forwarded-For)
TRUST_PROXY=1
# Токен для GET /api/admin/orders (список заказов). Пусто = выключено. Сгенерируйте длинную случайную строку.
ADMIN_TOKEN=
SUPPORT_EMAIL=info@lisinashop.ru

# --- Правила магазина ---
FREE_SHIPPING_FROM=4500
PICKUP_CITY=Волгоград

# --- ЮKassa (личный кабинет ЮKassa → Интеграция → Ключи API) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Система налогообложения для чека: 1 общая, 2 УСН доходы, 3 УСН доходы минус расходы, 4 ЕНВД, 5 ЕСХН, 6 патент
YOOKASSA_TAX_SYSTEM_CODE=3
# НДС: 1 без НДС, 2 НДС 0%, 3 НДС 10%, 4 НДС 20%
YOOKASSA_VAT_CODE=1
# Предмет расчёта: commodity (товар), service (услуга). Уточните у бухгалтера для электронных материалов.
PAY_SUBJECT_GOODS=commodity
PAY_SUBJECT_DIGITAL=service
PAY_SUBJECT_DELIVERY=service

# --- Telegram: заказы приходят менеджеру в этот чат ---
# Создайте бота у @BotFather, добавьте его в чат или напишите ему, chat id узнайте у @userinfobot или через getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Почта: письма покупателям (подтверждение и ссылки на материалы) ---
# Для почты домена на Mail.ru: smtp.mail.ru, порт 465, пароль для внешнего приложения из настроек ящика
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=info@lisinashop.ru
SMTP_PASS=
MAIL_FROM="LisinaShop <info@lisinashop.ru>"

# --- СДЭК (личный кабинет СДЭК → Интеграция → Ключи API) ---
CDEK_ACCOUNT=
CDEK_SECURE=
# Код города отправки по справочнику СДЭК (Волгоград, проверьте: GET /location/suggest/cities?name=Волгоград)
CDEK_FROM_CITY_CODE=426
# Тарифы: 136 посылка склад-склад (пункт выдачи), 137 посылка склад-дверь (курьер). Уточните по вашему договору.
CDEK_TARIFF_PVZ=136
CDEK_TARIFF_COURIER=137
# Вес товара, если не указан в каталоге, граммы. Габариты одной посылки, см.
DEFAULT_ITEM_WEIGHT_G=300
PACK_LENGTH_CM=20
PACK_WIDTH_CM=15
PACK_HEIGHT_CM=10
# Только для проверок: фиксированная цена доставки в рублях вместо расчёта СДЭК (0 = выключено).
# На сайте выбор города и пункта выдачи работает только с подключённым СДЭК (CDEK_ACCOUNT и CDEK_SECURE).
DELIVERY_FLAT_RUB=0

# Для проверки на тестовом контуре СДЭК: CDEK_API=https://api.edu.cdek.ru/v2 (тестовые ключи есть в документации СДЭК)
# Для проверки ЮKassa используйте тестовый магазин из личного кабинета ЮKassa
